#!/bin/sh
# Pushing main to origin publishes this OS's nightly update in the background (README → Updates).
# Skip once with SPILLWAY_SKIP_NIGHTLY=1 git push.
[ "$1" = origin ] || exit 0
[ -n "$SPILLWAY_SKIP_NIGHTLY" ] && exit 0
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != "$zero" ]; then
    node "$(git rev-parse --show-toplevel)/scripts/nightly-on-push.mjs" spawn "$local_sha"
  fi
done
exit 0
