{
  "name": "spillway",
  "productName": "Spillway",
  "private": true,
  "description": "Desktop app for a private CLIProxyAPI build: accounts, limits, tray.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-proxy.mjs --keep-last-good && electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "node scripts/build-linked.mjs && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "proxy:build": "node scripts/build-proxy.mjs",
    "package": "electron-vite build && electron-builder --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "release": "node scripts/release.mts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint-plugin-comment-budget": "github:Cujuju/eslint-plugin-comment-budget",
    "eslint-plugin-solid": "^0.18.1",
    "lucide-solid": "^1.61.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rollup-plugin-license": "3.7.1",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.0.0"
  },
  "dependencies": {
    "@cujuju/electron-updates": "link:../solidjs-toolkit/packages/electron-updates",
    "@cujuju/solidjs-color-picker": "0.3.0",
    "@cujuju/solidjs-hold-action": "link:../solidjs-toolkit/packages/hold-action",
    "@cujuju/solidjs-hooks": "link:../solidjs-toolkit/packages/hooks",
    "@cujuju/solidjs-kv-tooltip": "link:../solidjs-toolkit/packages/kv-tooltip",
    "@cujuju/solidjs-tiling-window-manager": "link:../solidjs-toolkit/packages/tiling-window-manager",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}
