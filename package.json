{
  "name": "cliproxy-desktop",
  "productName": "CLIProxy Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for a private CLIProxyAPI build: accounts, limits, tray.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "proxy:build": "node scripts/build-proxy.mjs",
    "package": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-solid": "^1.61.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
